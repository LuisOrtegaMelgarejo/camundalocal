# CAMUNDA_TARGET elige el entorno. Por defecto 'local'.
#   local -> Docker (docker-compose.yml de la raiz). No necesita credenciales.
#   saas  -> cluster de Camunda SaaS con OAuth.
CAMUNDA_TARGET=local

# --- local -------------------------------------------------------------------
# Valores por defecto; descomenta solo si cambias puertos en el compose.
# El gRPC lleva protocolo: grpc:// (sin TLS). Con ZEEBE_GRPC_ADDRESS el SDK
# ignora ZEEBE_INSECURE_CONNECTION y CAMUNDA_SECURE_CONNECTION.
#CAMUNDA_LOCAL_GRPC_ADDRESS=grpc://localhost:26500
#CAMUNDA_LOCAL_REST_ADDRESS=http://localhost:8080/v2

# --- saas --------------------------------------------------------------------
# Copia este archivo a .env y completa CLIENT_ID y CLIENT_SECRET con los del
# API Client (Console > tu cluster > API > tu client). No subas .env a git.
ZEEBE_ADDRESS=6a678ba7-da1a-4540-a318-d5ad00375a6e.ric-1.zeebe.camunda.io:443
ZEEBE_CLIENT_ID=
ZEEBE_CLIENT_SECRET=
ZEEBE_AUTHORIZATION_SERVER_URL=https://login.cloud.camunda.io/oauth/token
ZEEBE_TOKEN_AUDIENCE=zeebe.camunda.io

# API REST v2 (para consultar el padre). Console la muestra como
# https://ric-1.zeebe.camunda.io/:443/<cluster-id>/v2/ ; aqui va sin ":443/".
# Si falla, prueba con https://ric-1.api.camunda.io/<cluster-id>/v2
ZEEBE_REST_ADDRESS=https://ric-1.zeebe.camunda.io/6a678ba7-da1a-4540-a318-d5ad00375a6e/v2
