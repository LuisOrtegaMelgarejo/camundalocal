# --- Secretos: nunca subir ---------------------------------------------------
# Credenciales reales del cluster. El archivo de plantilla (env.example) si va.
.env
.env.*
!.env.example
!env.example

# Exportaciones de credenciales que descarga la consola de Camunda (traen el
# client secret en claro, en formato shell, .txt o .properties).
poc-call-activity-env.txt
poc-call-activity-springboot.properties
*-env.txt
*client-secret*
*credentials*

# --- Dependencias ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Salidas de ejecucion ----------------------------------------------------
*.log
camunda-support.log

# Datos locales del engine (el compose usa volumenes de Docker, pero por si
# alguna vez se monta un directorio).
camunda-data/
driver-lib/
secrets/

# --- Sistema operativo / editores --------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
*.swp

# POC 2: base SQLite local del backend
poc 2/backend/data/
